# Server
NODE_ENV=development
PORT=3000

# CORS
CORS_ORIGIN=http://localhost:19006,http://localhost:3000

# JWT — MUST match the secret used by auth-service to sign access tokens
JWT_ACCESS_SECRET=change_this_access_secret

# Downstream microservice URLs
AUTH_SERVICE_URL=http://localhost:3001
BRANCH_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
SALES_SERVICE_URL=http://localhost:3004
PURCHASE_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Proxy timeouts (ms)
PROXY_TIMEOUT_MS=15000

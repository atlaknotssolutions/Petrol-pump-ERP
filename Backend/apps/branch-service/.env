# Server
NODE_ENV=development
PORT=8002

# Database
MONGO_URI= mongodb+srv://atlaknotssolutions_db_user:g8WuxnK3EfID11BJ@cluster0.bwtk1j1.mongodb.net/?appName=Cluster0

# CORS (usually only the gateway calls this service, but kept for direct/local testing)
CORS_ORIGIN= true

# Internal trust — this service does NOT verify JWTs itself. It trusts the
# X-User-* identity headers injected by the gateway. This shared secret is
# an extra guard: the gateway sends it on every proxied request, and this
# service rejects requests that don't carry it (defense in depth in case a
# downstream service is ever exposed directly by mistake).
GATEWAY_SHARED_SECRET=change_this_shared_secret
